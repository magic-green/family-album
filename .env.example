# 拾光相册（family-album）环境变量示例
# 用法：cp .env.example .env ，然后按下方注释修改。
# Docker Compose 会自动读取同目录下的 .env；本地直跑时请自行 export（或设置）这些变量。
# 切勿把填好真实值的 .env 提交到版本库（根目录 .gitignore 已忽略 .env）。

# ---------- 必填 ----------
# 注册邀请码（强必填）：未设置时后端会直接报错拒绝启动，Compose 也会拒绝启动。
# 下面是明显的占位值，请务必改成你自己的随机字符串，不要保留示例值。
INVITE_CODE=change-me-please

# ---------- 认证（可选）----------
# JWT 签名密钥（可选）。留空即可：后端用安全随机值自动生成，并持久化到
# 数据库文件（DB_PATH）同目录下的 .jwt_secret，重启后自动复用（推荐做法）。
# 也可用 `openssl rand -hex 32` 自行生成固定值后填入，例如：
#     openssl rand -hex 32
# 请勿使用示例值或弱口令，也不要把真实密钥写进任何会被提交的文件。
JWT_SECRET=

# 登录令牌有效期（天），默认 30，每次打开应用会静默续期。
JWT_EXPIRE_DAYS=30

# ---------- 数据路径（默认注释，不建议在 .env 里设置）----------
# Docker Compose：这三项由编排文件按容器内绝对路径注入，不需要在 .env 设置。
# 本地直跑：后端从 backend/ 目录启动，相对路径以 backend/ 为基准，请按
#   README「快速开始 B」手动 export：
#     DATA_DIR=../data  DB_PATH=../db/app.db  STATIC_DIR=../frontend/dist
# 运行 scripts/seed_demo.py（从项目根执行）前请勿 export 这三项，
# 示例脚本按项目根相对路径写入 data/ 与 db/。
# DATA_DIR=data
# DB_PATH=db/app.db
# STATIC_DIR=frontend/dist

# ---------- 跨域（可选）----------
# 允许访问后端的前端来源，英文逗号分隔；
# 默认 http://localhost:5173,http://localhost:8020；经反向代理访问时请加上你的访问地址。
CORS_ORIGINS=http://localhost:5173,http://localhost:8020

# ---------- 可选：AI 自动打标签 ----------
# 兼容的视觉模型服务地址，默认 http://localhost:11434。
# 容器内访问宿主机上的模型服务时，请覆盖为 http://host.docker.internal:11434
# 并启用 docker-compose.yml 中注释掉的 extra_hosts。
# 未配置或模型不可用时，AI 打标签按设计自动降级，不影响上传与浏览。
# 启用后，打标签会把图片发送给你自己配置的模型服务，请自行评估隐私影响。
OLLAMA_URL=
# 视觉模型名称；留空表示使用程序默认值。
AI_TAG_MODEL=

# ---------- 可选：逆地理编码 ----------
# 地图服务密钥，用于把 GPS 坐标转换成中文地名；留空表示只显示原始坐标。
AMAP_KEY=
